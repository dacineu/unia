# Rust build artifacts
/target/
**/*.rs.bk

# Crash reports
*.rs~
*.swp
.*.swp

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editor / OS noise
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Python helper scripts
__pycache__/
*.py[cod]
.venv/
venv/

# `.ure` manifests at the repository root are written at runtime by the
# transducer, the orchestrator and the examples, which resolve relative to the
# process working directory. Running the test suite therefore drops files here.
# The curated manifests are force-added with `git add -f`; see docs/SPEC.md
# section 6 for why working-directory-relative resolution is a known hazard.

/*.ure
/orchestrator_*.ure
